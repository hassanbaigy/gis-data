# .env.example — committed template. Safe to commit (no real values).
# Copy to .env.local and fill in real values for local development.
#
# Dev B: run `cp .env.example .env.local` then paste tokens from
# https://account.mapbox.com/access-tokens/ into .env.local.

# Public token (pk.xxx) — exposed to the browser, used by Mapbox GL JS.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Secret token (sk.xxx) — server-only, used by /api/geocode, /api/hydrants/nearest,
# and by scripts/enrich-hydrants.ts at seed-data prep time.
# Must NOT have a NEXT_PUBLIC_ prefix.
MAPBOX_SECRET_TOKEN=

# Prisma SQLite database location. Kept in .env (not the schema) so production
# can override with a Postgres URL. The default below points at the local
# SQLite file that `prisma migrate dev` creates.
DATABASE_URL="file:./prisma/dev.db"
