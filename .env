# .env — committed, non-secret defaults. Override in .env.local for local
# tweaks. Real secrets (Mapbox tokens) go in .env.local, not here.
#
# Prisma reads this file from cwd by default. The relative `file:` URL
# is resolved relative to prisma/schema.prisma, so `file:./dev.db`
# means prisma/dev.db.

DATABASE_URL="file:./dev.db"
