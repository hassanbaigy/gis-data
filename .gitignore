# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed). `.env` is committed
# because it carries non-secret defaults (DATABASE_URL). Real secrets go
# in `.env.local`, which stays gitignored.
.env*
!.env.example
!.env

# delivery-workflow state (per-machine, not a deliverable)
.claude/state/
.claude-resume.md

# Playwright run artifacts — per-story screenshots and reports. Baselines
# (tests/screenshots/baseline/) ARE kept; per-run folders are not.
/tests/screenshots/*
!/tests/screenshots/baseline/
/tests/playwright-report/
/test-results/

# Prisma — local SQLite database file is per-machine; the schema and
# migrations are committed so anyone can recreate it via `prisma migrate dev`.
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude-agent-team — personal/local memory
.claude/agent-memory-local/
.claude/settings.local.json
